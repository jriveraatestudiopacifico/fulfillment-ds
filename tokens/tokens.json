{
  "$description": "FulfillmentOps design tokens. Cloudscape-inspired. Source of truth: Figma variables collection 'Cloudscape tokens'.",
  "color": {
    "text": {
      "body": { "$type": "color", "$value": "#000716" },
      "secondary": { "$type": "color", "$value": "#414d5c" },
      "muted": { "$type": "color", "$value": "#5f6b7a" },
      "inverted": { "$type": "color", "$value": "#ffffff" }
    },
    "bg": {
      "layout": { "$type": "color", "$value": "#f4f4f4" },
      "container": { "$type": "color", "$value": "#ffffff" },
      "selected": { "$type": "color", "$value": "#f2f8fd" },
      "nav-top": { "$type": "color", "$value": "#0f1b2a" },
      "error-subtle": { "$type": "color", "$value": "#fff7f7" }
    },
    "border": {
      "divider": { "$type": "color", "$value": "#e9ebed" },
      "container": { "$type": "color", "$value": "#c6c6cd" },
      "selected": { "$type": "color", "$value": "#0972d3" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "#0972d3" }
    },
    "status": {
      "error": { "$type": "color", "$value": "#d91515" },
      "warning": { "$type": "color", "$value": "#8d6605" },
      "warning-icon": { "$type": "color", "$value": "#c48a00" },
      "success": { "$type": "color", "$value": "#037f0c" },
      "info": { "$type": "color", "$value": "#0972d3" },
      "pending": { "$type": "color", "$value": "#5f6b7a" },
      "neutral": { "$type": "color", "$value": "#414d5c" }
    }
  },
  "space": {
    "xxs": { "$type": "dimension", "$value": "4px" },
    "xs": { "$type": "dimension", "$value": "8px" },
    "s": { "$type": "dimension", "$value": "12px" },
    "m": { "$type": "dimension", "$value": "16px" },
    "l": { "$type": "dimension", "$value": "20px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "xxl": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "badge": { "$type": "dimension", "$value": "4px" },
    "item": { "$type": "dimension", "$value": "8px" },
    "container": { "$type": "dimension", "$value": "16px" },
    "button": { "$type": "dimension", "$value": "20px" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "'Open Sans', 'Helvetica Neue', Arial, sans-serif" }
  },
  "typography": {
    "heading-xl": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "28px", "lineHeight": "36px" } },
    "heading-l": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "20px", "lineHeight": "24px" } },
    "heading-m": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "18px", "lineHeight": "22px" } },
    "heading-s": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "16px", "lineHeight": "20px" } },
    "body-m": { "$type": "typography", "$value": { "fontWeight": 400, "fontSize": "14px", "lineHeight": "20px" } },
    "body-m-strong": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": "14px", "lineHeight": "20px" } },
    "body-s": { "$type": "typography", "$value": { "fontWeight": 400, "fontSize": "12px", "lineHeight": "16px" } },
    "body-s-strong": { "$type": "typography", "$value": { "fontWeight": 600, "fontSize": "12px", "lineHeight": "16px" } }
  }
